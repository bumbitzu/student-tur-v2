{
  "name": "ssr-react",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/register": "^7.27.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "express": "^5.1.0",
    "ignore-styles": "^5.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "ssr": "node server/index.js",
    "dev": "concurrently -n \"BUILD,SSR\" -c \"blue,magenta\" \"npm run watch:build\" \"npm run watch:ssr\"",

  "watch:build": "nodemon --watch src --ext js,jsx,css --exec \"node build.mjs\"",
  "watch:ssr": "nodemon --watch server --watch build --ext js,jsx,html,css,json --exec \"node ssr.mjs\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "chalk": "^5.5.0",
    "concurrently": "^9.2.0",
    "nodemon": "^3.1.10"
  }
}
